DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=cctv
DATABASE_URL=postgres://postgres:secret@localhost:5432/cctv?sslmode=disable
RTSP_URL=rtsp://admin:admin@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0

S3_ENDPOINT=localhost:9000
S3_BUCKET=cctv-archive
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# OCI Object Storage for this client's member faces & avatars.
# Identity → Users → (your user) → Customer Secret Keys → Generate.
# Change OCI_REGION if the bucket is not in ap-singapore-1.
OCI_REGION=ap-singapore-1
OCI_NAMESPACE=axyalcmd4cit
OCI_FACES_BUCKET=bucket-faces-cctv
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
