# Copy this file to .env and fill in real values.
# Docker Compose interpolates DATABASE_URL into auth, core, nvr, and bgrd.
# Local tools (seed, migrate) also read DATABASE_URL from .env.

DATABASE_URL=postgres://user:password@host:5432/cctv?sslmode=require

S3_ENDPOINT=localhost:9000
S3_BUCKET=cctv-archive
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# OCI Object Storage for member faces & avatars (S3-compatible API).
# Identity → Users → (your user) → Customer secret keys → Generate.
# OCI_ACCESS_KEY must be the generated Access Key ID (long string shown in the list),
# NOT the Name you typed when creating the key (e.g. storage_faces_key).
# OCI_SECRET_KEY is shown only once at creation time.
# Change OCI_REGION if the bucket is not in ap-singapore-1.
OCI_REGION=ap-singapore-1
OCI_NAMESPACE=axyalcmd4cit
OCI_FACES_BUCKET=bucket-faces-cctv
OCI_ACCESS_KEY=
OCI_SECRET_KEY=

# Firebase Cloud Messaging (Web Push via VAPID).
# Web config + VAPID_PUBLIC_KEY are served by core-service to the SPA.
# Service-account credentials and VAPID_PRIVATE_KEY are used only by push-service.
# 1. Firebase Console → Project settings → General → Your apps → Web app config.
# 2. Project settings → Cloud Messaging → Web Push certificates → Generate key pair
#    (or import an existing VAPID key pair). Use the public key as VAPID_PUBLIC_KEY.
# 3. Project settings → Service accounts → Generate new private key.
#    Either paste the JSON as FIREBASE_CREDENTIALS_JSON, or set the three fields below.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER=mailto:admin@quoctran.space
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
