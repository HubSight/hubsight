{
  "name": "@hubsight/realtime",
  "version": "0.1.0",
  "description": "HubSight realtime SDK — Socket.IO event bus + WebRTC live streaming client",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "socket.io-client": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  }
}
