{
  "name": "@hubsight/api",
  "version": "0.1.0",
  "description": "HubSight REST API SDK (Bridge layer re-exporting from unified @hubsight/sdk)",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@hubsight/sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
