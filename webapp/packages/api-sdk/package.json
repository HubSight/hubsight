{
  "name": "@hubsight/api",
  "version": "0.1.0",
  "description": "HubSight REST API SDK — typed, resource-namespaced client for the HubSight gateway",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@hubsight/realtime": "workspace:*"
  },
  "peerDependencies": {
    "axios": "^1.7.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  }
}
