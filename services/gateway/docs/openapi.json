  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Nhập JWT Access Token nhận được sau khi đăng nhập thành công."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Bắt buộc cho tất cả request vào nhóm Mobile & Desktop App API (`/api/app/v1/*`)."
      },
      "ClientIdAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Client-ID",
        "description": "Client ID định danh ứng dụng gọi API."
      },
      "ServiceKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Key",
        "description": "M2M Internal Service Key dùng cho giao tiếp nội bộ giữa các microservices."
      }
    },
    "schemas": {
      "StandardError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Mô tả chi tiết lỗi"
          },
          "code": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "status": {
            "type": "string",
            "example": "error"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "123Qwe!@"
          },
          "client_id": {
            "type": "string",
            "example": "hs_web_default"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refresh_token": {
            "type": "string",
            "example": "rt_9876543210abcdef..."
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "usr_c81j239kd9"
              },
              "username": {
                "type": "string",
                "example": "admin"
              },
              "full_name": {
                "type": "string",
                "example": "System Administrator"
              },
              "role": {
                "type": "string",
                "example": "admin"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "require_2fa": {
            "type": "boolean",
            "example": false
          },
          "two_factor_token": {
            "type": "string",
            "example": "2fa_temp_token_xyz"
          }
        }
      },
      "CameraItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cam_01h9x8y7z6a5b4c3d2e1"
          },
          "name": {
            "type": "string",
            "example": "Cổng Chính (Main Gate)"
          },
          "stream_url": {
            "type": "string",
            "example": "rtsp://admin:pass@192.168.1.100:554/stream1"
          },
          "sub_stream_url": {
            "type": "string",
            "example": "rtsp://admin:pass@192.168.1.100:554/stream2"
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "enable_ai": {
            "type": "boolean",
            "example": true
          },
          "enable_nvr": {
            "type": "boolean",
            "example": true
          },
          "retention_days": {
            "type": "integer",
            "example": 7
          },
          "status": {
            "type": "string",
            "example": "online"
          }
        }
      },
      "AppSystemStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "app_api_version": {
            "type": "string",
            "example": "v1"
          },
          "app_api_enabled": {
            "type": "boolean",
            "example": true
          },
          "features": {
            "type": "object",
            "properties": {
              "live_streaming": {
                "type": "boolean",
                "example": true
              },
              "multi_live": {
                "type": "boolean",
                "example": true
              },
              "archive_playback": {
                "type": "boolean",
                "example": true
              },
              "push_notifications": {
                "type": "boolean",
                "example": true
              },
              "profile_management": {
                "type": "boolean",
                "example": true
              }
            }
          }
        }
      },
      "NotificationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "notif_21charnanoid123"
          },
          "camera_id": {
            "type": "string",
            "example": "cam_01h9x8y7z6a5b4c3d2e1"
          },
          "camera_name": {
            "type": "string",
            "example": "Cổng Chính"
          },
          "type": {
            "type": "string",
            "example": "person_detected"
          },
          "title": {
            "type": "string",
            "example": "Phát hiện người tại Cổng Chính"
          },
          "message": {
            "type": "string",
            "example": "Hệ thống AI phát hiện đối tượng xâm nhập"
          },
          "thumbnail_url": {
            "type": "string",
            "example": "/api/archive/rec_123/thumbnail"
          },
          "is_read": {
            "type": "boolean",
            "example": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}